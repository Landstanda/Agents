        ],
        "combination_examples": [
            {
                "request": "Check if I got a response from John about the meeting",
                "services": [
                    {
                        "check_emails": "Search for emails from John"
                    },
                    {
                        "analyze_content": "Check if email mentions meeting"
                    }
                ]
            },
            {
                "request": "Forward any urgent emails to my phone",
                "services": [
                    {
                        "check_emails": "Get new emails"
                    },
                    {
                        "analyze_importance": "Filter urgent ones"
                    },
                    {
                        "send_notification": "Forward to phone"
                    }
                ]
            }
        ],
        "required_entities": [],
        "optional_entities": [
            "max_emails",
            "importance",
            "sender"
        ],
        "outputs": [
            "List of unread emails",
            "Email summaries"
        ]
    },
    "email_composer": {
        "name": "Email Composer",
        "description": "Create, reply to, or forward emails with optional attachments",
        "examples": [
            "Send an email to the team about the project update",
            "Reply to John's email about the meeting",
            "Forward the budget report to finance",
            "Send an email with the presentation attached"
